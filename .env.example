# Copiar a .env.local y completar. NUNCA commitear .env.local ni valores reales.

# --- Supabase (local: los muestra `npx supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (credenciales de PRUEBA en desarrollo) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Mails (Resend) ---
RESEND_API_KEY=
MAIL_FROM=

# --- Captcha (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App ---
APP_URL=http://localhost:3000
